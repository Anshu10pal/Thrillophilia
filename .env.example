# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── Live APIs ──────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_key
GEOAPIFY_API_KEY=your_key
OPENROUTE_API_KEY=your_key

# ── Redis (Upstash) ────────────────────────────────────────────
# Get from: https://upstash.com → Create Database → Copy Redis URL
UPSTASH_REDIS_URL=rediss://default:xxxx@xxxx.upstash.io:6379

# ── LangSmith Tracing ─────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_key
LANGCHAIN_PROJECT=Thrillophilia-TripPlanner

# ── CORS (set to your React app URL in production) ────────────
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
